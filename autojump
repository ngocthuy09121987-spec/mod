local function updateJumpBtn()
    if autoJump then
        jumpBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        js.Color = Color3.fromRGB(255, 0, 0)
    else
        jumpBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        js.Color = Color3.fromRGB(0, 255, 0)
    end
end

confirmBtn.MouseButton1Click:Connect(function()
    if keyBox.Text == "autojump+menu" then
        keyActivated = true
        keyFrame.Visible = false
        mainFrame.Visible = true
        evadeContent.Visible = true
        discordContent.Visible = false
        evadeTab.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        discordTab.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    else
        statusLabel.Text = "Sai key!"
    end
end)

jumpBtn.MouseButton1Click:Connect(function()
    if not keyActivated then return end
    autoJump = not autoJump
    updateJumpBtn()
end)

RunService.Heartbeat:Connect(function()
    if not keyActivated then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if autoJump then
        local now = tick()
        if now - lastJump >= 0.35 then
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                lastJump = now
            end
        end
    end
end)

player.CharacterAdded:Connect(function(newChar)
    lastJump = 0
end)
